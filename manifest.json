{
  "manifest_version": 3,
  "name": "YT Clean Feed",
  "version": "0.4",
  "description": "Hides creator posts and flags YouTube videos whose comments call them AI-generated (mobile and desktop).",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://m.youtube.com/*",
    "*://www.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "scripts": [
      "defaults.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://m.youtube.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YT Clean Feed settings",
    "default_popup": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-clean-feed@ar.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
